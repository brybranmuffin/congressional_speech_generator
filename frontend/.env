# Combined backend (generation + EMI) on Azure Container Apps.
# Plain `.env` is read in ALL Vite modes — both `npm run dev` and `npm run build`.
# To point at a local backend instead, override here or in a gitignored `.env.local`.
VITE_API_BASE=https://emiapi.blackbay-d290dd52.centralus.azurecontainerapps.io
